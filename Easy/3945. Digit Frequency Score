class Solution {
public:
    int digitFrequencyScore(int n) {
        vector <int> arr;
        while(n!=0){
            arr.push_back(n%10);
            n=n/10;
        }
        int sum=0;
        for(int i=0;i<arr.size();i++){
            if(arr[i]==-1){
                continue;
            }
            int cnt=1;
            for(int j=i+1;j<arr.size();j++){
                if(arr[i]==arr[j]){
                    cnt++;
                    arr[j]=-1;
                }
            }
            sum = sum + arr[i]*cnt;
            
        }
        return sum;
    }
};
