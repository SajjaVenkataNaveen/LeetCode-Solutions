class Solution {
public:
    int gcdOfOddEvenSums(int n) {
        int odd = 1;
        int even = 2;
        
        for(int i=1;i<n;i++){
            odd = odd+2;
            even = even+2;
        }

        int m = min(odd,even);

        int gcd = 1;
        for(int i=2;i<=m;i++){
            if((odd%1)==0 && (even%i)==0){
                gcd = i;
            }
        }

        return gcd;
    }
};
