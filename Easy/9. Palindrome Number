class Solution {
public:
    bool isPalindrome(int x) {
        if(x<0){
            return false;
        }

        int org = x;
        int reverse=0;
        int temp = 0;

        while(x != 0){
            temp = x%10;
            if (reverse > INT_MAX/10 || reverse < INT_MIN/10)
                return 0;
            reverse = reverse*10 + temp;
            x = x/10;
        }

        if(org==reverse){
            return true;
        }else{
            return false;
        }
    }
};
