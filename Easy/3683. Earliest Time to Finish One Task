class Solution {
public:
    int earliestTime(vector<vector<int>>& tasks) {
        int min=tasks[0][0]+tasks[0][1];
        for(int i=0;i<tasks.size();i++){
            int temp=0;
            for(int j=0;j<tasks[i].size();j++){
                temp = temp + tasks[i][j];
            }
            if(temp<min){
                min=temp;
            }
        }
        return min;
    }
};
