class Solution {
public:
    bool isSameAfterReversals(int num) {
        int original = num;
        int ans = 0;

        while(num != 0){
            int temp = num % 10;
            ans = ans * 10 + temp;
            num = num / 10;
        }
        
        int ans2 = ans;
        int ans1 = 0;

        while(ans != 0){
            int temp = ans % 10;
            ans1 = ans1 * 10 + temp;
            ans = ans / 10;
        }

        return (ans1 == original);
    }
};
