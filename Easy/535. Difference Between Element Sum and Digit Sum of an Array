class Solution {
public:
    int differenceOfSum(vector<int>& nums) {
        int elsum =0;
        for(int i=0;i<nums.size();i++){
            elsum += nums[i];
        }

        int dgsum =0;
        for(int i=0;i<nums.size();i++){
            int temp=0;
            while(nums[i]>0){
                temp = nums[i]%10;
                dgsum += temp;
                nums[i] /=10;
            }
        }

        return abs(dgsum-elsum);
    }
};
