class Solution {
public:
    int sumDecoded(vector<long long>& nums) {
        const int MOD=1e9 +7;
        long long ans=0;

        for(long long num : nums){
            int width = num%10;
            long long d = num/10;

            string s = to_string(d);

            long long x = stoll(s.substr(0,width));
            long long y = stoll(s.substr(width));

            long long power = 1;

            while(y>0){
               if(y%2==1){
                   power = (power*x)%MOD;
               }

                x = (x*x)%MOD;
                y /=2;
            }

            ans = (ans+power)%MOD;
        }
        return ans;
    }
};
