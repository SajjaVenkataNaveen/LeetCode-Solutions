class Solution {
public:
    int countDigitOccurrences(vector<int>& nums, int digit) {
        int ans=0;
        int n= nums.size();
        for(int i=0;i<n;i++){
            int temp = nums[i];
            while(temp !=0){
                int s= temp%10;
                if(s==digit){
                    ans++;
                }
                temp = temp/10;
            }
        }
        return ans;
    }
};
