class Solution {
public:
    int triangularSum(vector<int>& nums) {
        vector <int> ans(nums.size());
        if(nums.size()==1){
            return nums[0];
        }

        while(nums.size() !=1){
            ans.clear();
            for(int i=0;i<nums.size();i++){
                if(i != nums.size()-1){
                    ans.push_back((nums[i]+nums[i+1])%10);
                }
            }
            nums=ans;
        }

        return ans[0];

    }
};
