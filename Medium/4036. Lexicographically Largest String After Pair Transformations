class Solution {
public:
    vector<string> largestString(vector<int>& nums) {
        vector <string> ans;

        for(int x:nums){
            string s ="";

            int z = 1 <<25;

            while(x>=z){
                s += 'z';
                x -=z;
            }

            for(int bit=25;bit>=0;bit--){
                if(x & (1 << bit)){
                    s += char('a'+bit);
                }
            }
            ans.push_back(s);
        }
        return ans;
    }
};
